{
  "name": "hoggish-assistant",
  "version": "0.3.1",
  "description": "Shared AI chat assistant: provider fallback chain, quota tracking, confirm-before-action tool loop, NDJSON streaming, React hook, Markdown and Excel helpers.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exampleschool23/hoggish-assistant.git"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "sql",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "default": "./dist/markdown.js"
    },
    "./excel": {
      "types": "./dist/excel.d.ts",
      "import": "./dist/excel.js",
      "default": "./dist/excel.js"
    },
    "./supabase": {
      "types": "./dist/supabase.d.ts",
      "import": "./dist/supabase.js",
      "default": "./dist/supabase.js"
    },
    "./sql/assistant_model_usage.sql": "./sql/assistant_model_usage.sql",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.80",
    "@ai-sdk/google": "^4.0.96",
    "ai": "^7.0.141"
  },
  "peerDependencies": {
    "exceljs": "^4.4.0",
    "react": "^18.2.0 || ^19.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "peerDependenciesMeta": {
    "exceljs": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "exceljs": "^4.4.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "~5.9",
    "vitest": "^5.0.4",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
